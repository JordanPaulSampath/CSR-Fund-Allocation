# Backend environment. Set these in the Railway service "Variables" tab.
# Locally: copy to .env (loaded automatically) or export before `uvicorn`.

# --- Database (Supabase Postgres) ---------------------------------------------
# Supabase → Project Settings → Database → Connection string → "URI".
# Use the CONNECTION POOLER string (port 6543) for a serverless-style host like
# Railway; the direct string (port 5432) also works. Either scheme is accepted.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Leave DATABASE_URL blank to fall back to a local SQLite file (data/users.db).

# --- CORS --------------------------------------------------------------------
# Comma-separated allowed origins. Set this to your Vercel URL(s) in production.
# *.vercel.app preview deploys are allowed automatically once this is not "*".
#   CORS_ORIGINS=https://saarthi.vercel.app,https://www.saarthi.app
CORS_ORIGINS=*

# --- Auth -------------------------------------------------------------------
# CHANGE THIS in production — it signs the login tokens.
SAARTHI_SECRET=change-me-to-a-long-random-string
SAARTHI_TOKEN_TTL=86400

# Set to 0 to stop seeding the 10 demo logins (once you have real users).
SAARTHI_SEED_DEMO=1
