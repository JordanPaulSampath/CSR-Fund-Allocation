# Copy to .env.local for local dev, or set these in the Vercel project settings.

# Base URL of the deployed backend (Railway). Leave BLANK for local dev — the
# Vite dev server proxies /api, /auth, /allocate, … to http://localhost:8000.
# In production this MUST point at your Railway service, no trailing slash:
VITE_API_URL=https://your-backend.up.railway.app
